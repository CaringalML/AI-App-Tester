# Copy to terraform.tfvars (gitignored). cloudflare_api_token is never set here;
# export TF_VAR_cloudflare_api_token instead.

project_name  = "ai-app-tester"
aws_region    = "ap-southeast-2"
domain_name   = "nodepulsecaringal.xyz"
api_subdomain = "api"

github_repo        = "CaringalML/AI-App-Tester"
github_environment = "production"

anthropic_model = "claude-opus-5-5"
# Only for organization-level keys that are not scoped to a workspace.
anthropic_workspace_id = "wrkspc_01Wqia2TeDBpN3RHt3qe5zSN"
agent_effort           = "medium"

# Quick scan (the default): about 2 minutes. Its time limit is set in the app (240s).
max_agent_steps = 30
# Thorough scan, chosen per scan in the form: up to 100 actions and 30 minutes.
thorough_agent_steps     = 100
thorough_timeout_seconds = 1800

task_cpu    = 1024
task_memory = 2048
