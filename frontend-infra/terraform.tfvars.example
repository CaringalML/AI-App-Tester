# Copy to terraform.tfvars and fill in, or set every value as an environment
# variable instead (TF_VAR_domain_name, and so on). terraform.tfvars is
# gitignored; only this example file is tracked.
#
# cloudflare_api_token has no default and no example value here on purpose.
# Export it directly: TF_VAR_cloudflare_api_token=... terraform plan
# Never put a real token in a file that could end up committed.

project_name = "ai-app-tester"
aws_region   = "ap-southeast-2"
domain_name  = "nodepulsecaringal.xyz"
create_www   = true

github_repo        = "CaringalML/AI-App-Tester"
github_environment = "production" # must match the `environment:` key in frontend-deploy.yml

cloudfront_price_class = "PriceClass_All"
cloudflare_ssl_mode     = "strict"
