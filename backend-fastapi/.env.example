# Copy to .env for local development. .env is gitignored and excluded from the image.
# In AWS the key comes from Secrets Manager, never from this file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
REVIEW_EFFORT=medium
MAX_AGENT_STEPS=30
SCAN_TIMEOUT_SECONDS=240

CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000
# Lets you scan a dev server on localhost. Never enable this in AWS.
ALLOW_PRIVATE_TARGETS=true

# Leave unset locally to use in-memory storage and ./.artifacts for screenshots.
# DYNAMODB_TABLE=
# ARTIFACT_BUCKET=
